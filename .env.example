# Write-only secret for POST /api/leads/ingest. The ChatGPT LP should send this
# from a server route, not from public browser JavaScript.
LEADS_INGEST_SECRET=

# Separate operator secret for GET /api/leads and PATCH /api/leads/:id.
# Must differ from LEADS_INGEST_SECRET. Used only on this dashboard origin.
LEADS_OPERATOR_SECRET=

# Optional comma-separated extra CORS origins for POST ingest only.
# LEADS_INGEST_ORIGINS=https://exquisitedentistryla.com
